{
  "expo": {
    "name": "VibeLoop",
    "slug": "vibeloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vibeloop.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C3BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.vibeloop.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VibeLoop uses your photos only when you pick one to post or send.",
          "cameraPermission": "VibeLoop uses the camera only when you take a photo to post."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VibeLoop uses your location only when you tag a place on a post or story."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "VibeLoop uses the microphone for voice notes and calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VibeLoop uses the camera for photos, Blinks, snaps and video calls.",
          "microphonePermission": "VibeLoop uses the microphone for videos, voice notes and calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4CF5"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "VibeLoop uses the camera for video calls.",
          "microphonePermission": "VibeLoop uses the microphone for calls."
        }
      ]
    ],
    "scheme": "vibeloop",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#120F24"
    }
  }
}