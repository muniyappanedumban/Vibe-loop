# VibeLoop API — environment variables. Copy to .env (gitignored) or set them in your process manager / secret store.
# The app reads os.environ only; it does not load .env itself (use `set -a; . ./.env; set +a`, systemd EnvironmentFile, docker --env-file …).
#
# Payment / OTP / Maps provider keys are NOT env vars: they are entered in Admin → Plugs and stored Fernet-encrypted (MASTER_KEY).

# ---------- mode ----------
# dev  = convenient fallbacks (random per-process secrets, demo OTP codes in responses, CORS *).
# prod = refuses to start unless every secret below is set, DEMO_OTP=0 and CORS_ORIGINS lists explicit origins.
ENV=dev

# ---------- database ----------
# dev default: postgresql+psycopg://localhost/vibeloop        LIVE: required, use TLS (…?sslmode=require), a least-privilege role.
DATABASE_URL=postgresql+psycopg://localhost/vibeloop
# Connection pool per API process. Total ≈ replicas × workers × (POOL_SIZE + MAX_OVERFLOW) — keep below max_connections / PgBouncer pool.
POOL_SIZE=10
MAX_OVERFLOW=20
# Seconds before a pooled connection is recycled (beat LB / PgBouncer idle timeouts).
POOL_RECYCLE=1800
# Seconds to wait for a free pooled connection before failing the request.
POOL_TIMEOUT=30
# Per-statement timeout in ms (Postgres statement_timeout). 0 disables.
STATEMENT_TIMEOUT_MS=15000

# ---------- secrets (LIVE: all required, ≥32 chars, all different; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))") ----------
# Signs access tokens (HS256). Rotating it signs everyone out.        dev: random per process if unset
JWT_SECRET=
# Signs one-time approval tokens (publish / payout / admin decisions).  dev: random per process if unset
APPROVAL_SECRET=
# HMAC key for OTP code hashes.                                        dev: random per process if unset
OTP_SECRET=
# Fernet key (or any passphrase) for provider secrets at rest (Admin → Plugs). Changing it makes stored keys unreadable — re-enter them.
# dev: generated into backend/.master_key (gitignored) if unset.  Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MASTER_KEY=

# ---------- auth ----------
# Access token lifetime in minutes (default 720 = 12 h, clamped to 5..1440).
ACCESS_TTL_MIN=720
# Clock-skew leeway (seconds) when checking token exp/iat.
JWT_LEEWAY_SEC=30
# 1 = OTP codes are returned in API responses (demo only).   LIVE: must be 0 (prod refuses to start otherwise). Default: 1 in dev, 0 in prod.
DEMO_OTP=1

# ---------- HTTP ----------
# Comma-separated allowed browser origins (admin console, web app).   dev: *     LIVE: e.g. https://admin.vibeloop.app,https://vibeloop.app  ("*" refused)
CORS_ORIGINS=*
# 1 only when behind your own load balancer that sets X-Forwarded-For (used for per-IP rate limits). Otherwise clients could spoof their IP.
TRUST_PROXY=0

# ---------- rate limits ----------
# Shared limiter store. Unset → in-memory (per process; fine for one dev process, NOT for multiple workers/replicas).
# LIVE: set it, e.g. redis://:password@redis:6379/0 (or rediss:// for TLS). If Redis is down the limiter fails open and logs an error.
REDIS_URL=

# ---------- media ----------
# Local directory for uploads (dev). LIVE: a persistent volume — or move to object storage + CDN (see docs/ARCHITECTURE.md).
# dev default: backend/media.
# MEDIA_DIR=/var/lib/vibeloop/media
# Lifetime (seconds) of signed links to private chat attachments (bucketed, so links live between 1× and 2× this).
MEDIA_LINK_TTL_SEC=86400

# ---------- money ----------
# Legacy creator-loop platform fee shown in /bootstrap (the money module's fee is set in Admin → Money).
PLATFORM_FEE=0.08
